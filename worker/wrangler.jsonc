{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "debug-english-feedback",
  "main": "src/index.js",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://sergiojr06.github.io",
    "EXPECTED_TURNSTILE_HOSTNAME": "sergiojr06.github.io"
  },
  "ratelimits": [
    {
      "name": "FEEDBACK_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ]
}
